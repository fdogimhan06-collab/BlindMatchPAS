@model IEnumerable<BlindMatchPAS.Models.Match>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="page-title mb-4">
    <i class="fas fa-tachometer-alt"></i> All Matches Dashboard
</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white"
             style="background: linear-gradient(135deg, #667eea, #764ba2);">
            <div class="card-body text-center">
                <i class="fas fa-handshake fa-2x"></i>
                <h3 class="mt-2">@Model.Count()</h3>
                <p>Total Matches</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white"
             style="background: linear-gradient(135deg, #11998e, #38ef7d);">
            <div class="card-body text-center">
                <i class="fas fa-check-circle fa-2x"></i>
                <h3 class="mt-2">@Model.Count(m => m.IsRevealed)</h3>
                <p>Confirmed Matches</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white"
             style="background: linear-gradient(135deg, #f7971e, #ffd200);">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x"></i>
                <h3 class="mt-2">@Model.Count(m => !m.IsRevealed)</h3>
                <p>Pending Matches</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header text-white"
         style="background: linear-gradient(135deg, #1a1a2e, #16213e);">
        <i class="fas fa-list"></i> Match Details
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Student</th>
                    <th>Supervisor</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model)
                {
                    <tr>
                        <td>@match.Project?.Title</td>
                        <td>@match.Project?.Student?.FullName</td>
                        <td>@match.Supervisor?.FullName</td>
                        <td>
                            @if (match.IsRevealed)
                            {
                                <span class="badge bg-success">Matched</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                        </td>
                        <td>@match.MatchedOn.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="ResearchAreas" class="btn btn-primary me-2">
        <i class="fas fa-tags"></i> Manage Research Areas
    </a>
    <a asp-action="Users" class="btn btn-secondary">
        <i class="fas fa-users"></i> Manage Users
    </a>
</div>