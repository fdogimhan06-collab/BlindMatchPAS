@model IEnumerable<BlindMatchPAS.Models.Match>
@{
    ViewData["Title"] = "All Matches Dashboard";
}

<h2>All Matches Dashboard</h2>

<table class="table">
    <thead>
        <tr>
            <th>Project</th>
            <th>Student</th>
            <th>Supervisor</th>
            <th>Status</th>
            <th>Matched On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var match in Model)
        {
            <tr>
                <td>@match.Project?.Title</td>
                <td>@match.Project?.Student?.FullName</td>
                <td>@match.Supervisor?.FullName</td>
                <td>
                    @if (match.IsRevealed)
                    {
                        <span class="badge bg-success">Matched</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </td>
                <td>@match.MatchedOn.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="ResearchAreas" class="btn btn-primary mt-3">
    Manage Research Areas
</a>
<a asp-action="Users" class="btn btn-secondary mt-3">
    Manage Users
</a>