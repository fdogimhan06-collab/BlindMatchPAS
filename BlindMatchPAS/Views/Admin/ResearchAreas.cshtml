@model IEnumerable<BlindMatchPAS.Models.ResearchArea>
@{
    ViewData["Title"] = "Manage Research Areas";
}

<h2>Manage Research Areas</h2>

<form method="post" asp-action="AddResearchArea" class="mb-4">
    <div class="input-group">
        <input name="name" class="form-control"
               placeholder="New Research Area" required />
        <div class="mb-3">
            <label class="form-label fw-bold">
                <i class="fas fa-file-upload"></i> Upload File (Optional)
            </label>
            <input type="file" name="uploadedFile" class="form-control" />
            <small class="text-muted">PDF, DOC, DOCX files accepted</small>
        </div>
               <button type="submit" class="btn btn-primary">
            Add
        </button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Research Area</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var area in Model)
        {
            <tr>
                <td>@area.Id</td>
                <td>@area.Name</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary mt-3">
    Back to Dashboard
</a>