@model IEnumerable<BlindMatchPAS.Models.Project>
@{
    ViewData["Title"] = "My Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title">
        <i class="fas fa-graduation-cap"></i> My Projects
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Submit New Project
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        No projects yet. Submit your first project!
    </div>
}
else
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-project-diagram"></i>
                            @project.Title
                        </h5>
                        <p class="text-muted">
                            <i class="fas fa-tag"></i>
                            @project.ResearchArea?.Name
                        </p>
                        <span class="badge @(project.Status == "Matched" ? "bg-success" : project.Status == "UnderReview" ? "bg-warning" : "bg-secondary")">
                            @project.Status
                        </span>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Status" asp-route-id="@project.Id"
                               class="btn btn-sm btn-primary">
                            <i class="fas fa-eye"></i> View Status
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}