@model IEnumerable<BlindMatchPAS.Models.Project>
@{
    ViewData["Title"] = "My Projects";
}

<h2>My Projects</h2>
<a asp-action="Create" class="btn btn-primary mb-3">
    + Submit New Project
</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Research Area</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Title</td>
                <td>@project.ResearchArea?.Name</td>
                <td>@project.Status</td>
                <td>
                    <a asp-action="Status"
                       asp-route-id="@project.Id"
                       class="btn btn-info btn-sm">
                        View Status
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>