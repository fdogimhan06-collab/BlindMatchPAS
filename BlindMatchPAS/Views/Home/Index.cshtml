@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <div class="card mx-auto" style="max-width: 700px;">
        <div class="card-body py-5">
            <h1 class="display-4 fw-bold" style="color: #1a1a2e;">
                <i class="fas fa-user-secret"></i> BlindMatchPAS
            </h1>
            <p class="lead text-muted mt-3">
                A fair and unbiased Project Approval System where
                supervisors review proposals anonymously.
            </p>
            <hr />
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white p-3">
                        <i class="fas fa-graduation-cap fa-2x"></i>
                        <h5 class="mt-2">Students</h5>
                        <p>Submit project proposals</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white p-3">
                        <i class="fas fa-chalkboard-teacher fa-2x"></i>
                        <h5 class="mt-2">Supervisors</h5>
                        <p>Review projects blindly</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-white p-3">
                        <i class="fas fa-user-shield fa-2x"></i>
                        <h5 class="mt-2">Admin</h5>
                        <p>Oversee all matches</p>
                    </div>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Login"
                   class="btn btn-primary btn-lg mt-4">
                <i class="fas fa-sign-in-alt"></i> Get Started
            </a>
        </div>
    </div>
</div>